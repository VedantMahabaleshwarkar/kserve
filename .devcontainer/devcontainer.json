{
  "name": "KServe E2E Tests",
  "image": "ghcr.io/vedantmahabaleshwarkar/kserve-e2e-devcontainer:latest",
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "none"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "remoteEnv": {
    "KO_DOCKER_REPO": "kserve"
  }
}
